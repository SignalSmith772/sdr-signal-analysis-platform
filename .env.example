# ─────────────────────────────────────────────
#  SDR Signal Analysis Platform — Environment
# ─────────────────────────────────────────────

# Database
DATABASE_URL=sqlite:///./sdr_platform.db

# ML model path (relative to backend/)
ML_MODEL_PATH=../ml/models/modulation_classifier.pkl

# Demo / synthetic data settings
DEMO_SAMPLE_RATE=2400000
DEMO_CENTER_FREQ=100000000
DEMO_NUM_SAMPLES=4096

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API prefix
API_PREFIX=/api

# Debug mode
DEBUG=true
